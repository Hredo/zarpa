rules_version = '2';

/*
 * Reglas de Firestore de Zarpa.
 *
 * Zarpa funciona en el plan gratuito de Firebase (Spark): no hay Cloud
 * Functions, así que todo lo escribe la app y estas reglas son la única
 * defensa. Principio: todo está cerrado salvo lo que cada persona hace con lo
 * suyo.
 *   - Nadie lee ni escribe datos de otro usuario, salvo lo social y solo con
 *     el consentimiento del otro (ver abajo).
 *   - El perfil lo crea su dueño con una forma fija (contadores a cero, sin
 *     código de amigo) y luego solo cambia alias, foto, compartir, contadores
 *     y, una sola vez, su código de amigo.
 *   - Lo social es solo entre amigos: no hay buscador de personas. Se añade a
 *     alguien con su código (`friendCodes/{código}` se puede leer de uno en
 *     uno, nunca listar). Una amistad solo se apunta en la lista del otro si
 *     el otro te lo pidió antes (`friendRequests`). El álbum compartido lo ven
 *     los amigos y solo si su dueño lo comparte (`shareAlbum`).
 *   - Los avistamientos son una copia de la tabla local `sighting`: los campos
 *     conocidos se validan por tipo y tamaño, y se admiten hasta 40 campos para
 *     que el cuaderno gane columnas (notas, clima, audio) sin tocar las reglas.
 *   - Borrar la cuenta lo hace la app: por eso el dueño puede borrar todo lo
 *     suyo y retirar su rastro de las listas de sus amigos.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isFriendOf(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }
    function sharesAlbum(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('shareAlbum', false) == true;
    }

    // Validadores de campo opcional: ausente o null también valen.
    function optString(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    function optInt(d, k) {
      return !(k in d) || d[k] == null || d[k] is int;
    }
    function optNumber(d, k, lo, hi) {
      return !(k in d) || d[k] == null || (d[k] is number && d[k] >= lo && d[k] <= hi);
    }
    function optBool(d, k) {
      return !(k in d) || d[k] == null || d[k] is bool;
    }
    function optIn(d, k, values) {
      return !(k in d) || d[k] == null || d[k] in values;
    }

    // Formatos compartidos por el perfil, el perfil público y las amistades.
    function validAlias(a) {
      return a is string && a.size() >= 1 && a.size() <= 40;
    }
    function validPhoto(p) {
      return p == null || (p is string && p.size() <= 1000 && p.matches('https://.*'));
    }
    function validCount(n) {
      return n is int && n >= 0 && n <= 10000000;
    }
    function validCode(c) {
      // Mismo alfabeto que la app (social/api.ts): sin 0/O ni 1/I/L.
      return c is string && c.matches('[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{8}');
    }

    // ---- Perfil ---------------------------------------------------------
    match /users/{uid} {
      function validCounters(c) {
        return c is map && c.keys().hasOnly(['sightings', 'species'])
          && validCount(c.get('sightings', 0)) && validCount(c.get('species', 0));
      }
      // El código de amigo se pone una sola vez y solo si su índice
      // `friendCodes/{código}` apunta a esta cuenta tras la misma escritura.
      function friendCodeOk(before, after) {
        return after.get('friendCode', null) == before.get('friendCode', null)
          || (before.get('friendCode', null) == null
              && validCode(after.get('friendCode', null))
              && getAfter(/databases/$(database)/documents/friendCodes/$(after.friendCode)).data.uid == uid);
      }

      allow read: if isOwner(uid);
      // Alta: la hace la app al entrar por primera vez, con la forma de partida.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['alias', 'photoURL', 'createdAt', 'updatedAt', 'counters', 'shareAlbum'])
        && validAlias(request.resource.data.alias)
        && validPhoto(request.resource.data.get('photoURL', null))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.counters == {'sightings': 0, 'species': 0}
        && request.resource.data.shareAlbum == false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alias', 'photoURL', 'shareAlbum', 'counters', 'friendCode', 'updatedAt'])
        && validAlias(request.resource.data.alias)
        && validPhoto(request.resource.data.get('photoURL', null))
        && request.resource.data.get('shareAlbum', false) is bool
        && validCounters(request.resource.data.get('counters', {}))
        && friendCodeOk(resource.data, request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);

      // Ajustes privados (idioma, modo niños, preferencias de sincronización...).
      match /private/{doc} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && doc == 'settings'
          && request.resource.data.keys().size() <= 20;
        allow delete: if isOwner(uid);
      }

      // ---- Avistamientos (copia en la nube del cuaderno) -----------------
      match /sightings/{id} {
        function validSighting(d) {
          return id.matches('[A-Za-z0-9_-]{1,64}')
            && d.keys().size() <= 40
            && d.created_at is string && d.created_at.size() >= 10 && d.created_at.size() <= 40
            && d.method in ['ia', 'manual']
            && d.verified in [0, 1]
            && optInt(d, 'species_id')
            && optString(d, 'breed_id', 64)
            && optNumber(d, 'lat', -90, 90)
            && optNumber(d, 'lng', -180, 180)
            && optNumber(d, 'accuracy', 0, 1000000)
            && optString(d, 'place', 300)
            && optNumber(d, 'confidence', 0, 1)
            && optString(d, 'candidates', 20000)
            && optString(d, 'model', 120)
            && optString(d, 'note', 5000)
            && d.has_photo is bool
            // Pegatina y nota de voz (sus ficheros, en Storage si está activo).
            && optBool(d, 'has_sticker')
            && optBool(d, 'has_voice')
            && optIn(d, 'sticker_ext', ['png', 'jpg'])
            && optIn(d, 'voice_ext', ['m4a', 'aac', 'mp4', 'caf', '3gp'])
            && optNumber(d, 'voice_ms', 0, 3600000)
            // Diario de campo: clima de Open-Meteo y momento del día.
            && optNumber(d, 'weather_code', 0, 99)
            && optNumber(d, 'weather_temp', -90, 70)
            && optNumber(d, 'weather_feels', -100, 80)
            && optNumber(d, 'weather_humidity', 0, 100)
            && optNumber(d, 'weather_wind', 0, 500)
            && optIn(d, 'weather_is_day', [0, 1])
            && optString(d, 'weather_at', 40)
            && optIn(d, 'day_phase', ['amanecer', 'manana', 'mediodia', 'tarde', 'atardecer', 'noche'])
            && optString(d, 'updated_at', 40)
            && optNumber(d, 'schema', 1, 1000)
            // Aportación a iNaturalist.
            && optInt(d, 'inat_id')
            && optString(d, 'inat_uploaded_at', 40);
        }
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSighting(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // ---- Solicitudes de amistad ------------------------------------------
      // `users/{uid}/friendRequests/{fromUid}`: la escribe quien pide (fromUid),
      // con su alias y su foto; la lee y la borra quien la recibe (uid). Quien
      // la envió puede retirarla (también al borrar su cuenta).
      match /friendRequests/{fromUid} {
        function validRequest(d) {
          return d.keys().hasOnly(['from', 'alias', 'photoURL', 'at'])
            && d.from == fromUid
            && validAlias(d.alias)
            && validPhoto(d.get('photoURL', null))
            && d.at == request.time;
        }
        allow read: if isOwner(uid);
        allow get: if isOwner(fromUid);
        allow create, update: if isOwner(fromUid) && fromUid != uid
          && exists(/databases/$(database)/documents/users/$(uid))
          && validRequest(request.resource.data);
        allow delete: if isOwner(uid) || isOwner(fromUid);
      }

      // ---- Amistades --------------------------------------------------------
      // Una ficha en cada sentido: `users/A/friends/B` y `users/B/friends/A`,
      // con el alias y la foto del amigo. Las escribe quien acepta (B acepta la
      // solicitud de A): la suya, y la de A solo porque A se lo pidió antes.
      match /friends/{fid} {
        function validFriend(d) {
          return d.keys().hasOnly(['since', 'alias', 'photoURL'])
            && d.since == request.time
            && validAlias(d.alias)
            && validPhoto(d.get('photoURL', null));
        }
        // `by` pidió amistad a `to` (la solicitud está en la lista de `to`).
        function requested(by, to) {
          return exists(/databases/$(database)/documents/users/$(to)/friendRequests/$(by));
        }
        allow read: if isOwner(uid);
        // Mi lista: al aceptar su solicitud, o si ya estoy en la suya.
        // Su lista: me apunto yo (fid) solo si él (uid) me lo pidió.
        allow create: if fid != uid && validFriend(request.resource.data)
          && ((isOwner(uid) && (requested(fid, uid) || exists(/databases/$(database)/documents/users/$(fid)/friends/$(uid))))
              || (isOwner(fid) && requested(uid, fid)));
        // Alias y foto al día: los refresca el propio amigo cuando los cambia.
        allow update: if (isOwner(uid) || isOwner(fid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alias', 'photoURL'])
          && validAlias(request.resource.data.alias)
          && validPhoto(request.resource.data.get('photoURL', null));
        // Dejar de ser amigos: cualquiera de los dos borra las dos fichas.
        allow delete: if isOwner(uid) || isOwner(fid);
      }

      // ---- Álbum compartido con los amigos --------------------------------
      // Una ficha por especie: recuento, primer y último mes, y la pegatina
      // elegida. Sin lugares ni coordenadas.
      match /album/{speciesId} {
        function validAlbum(d) {
          return speciesId.matches('[0-9]{1,12}')
            && d.keys().hasOnly(['species_id', 'count', 'first', 'last', 'sticker', 'sticker_ext', 'updated_at'])
            && d.species_id is int && string(d.species_id) == speciesId
            && d.count is int && d.count >= 1 && d.count <= 100000
            && d.first is string && d.first.matches('[0-9]{4}-[0-9]{2}')
            && d.last is string && d.last.matches('[0-9]{4}-[0-9]{2}')
            && (d.sticker == null || (d.sticker is string && d.sticker.matches('[A-Za-z0-9_-]{1,64}')))
            && (d.sticker_ext == null || d.sticker_ext in ['png', 'jpg'])
            && d.updated_at is string && d.updated_at.size() <= 40;
        }
        allow read: if isOwner(uid) || (isFriendOf(uid) && sharesAlbum(uid));
        allow create, update: if isOwner(uid) && sharesAlbum(uid) && validAlbum(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    // ---- Perfil público: alias, avatar, contadores y si comparte álbum. Lo
    // escribe su dueño (copia de su perfil); lo lee quien tenga cuenta y sepa
    // el uid (para ver quién te pide amistad). No se puede listar.
    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['alias', 'photoURL', 'shareAlbum', 'sightings', 'species', 'updatedAt'])
        && validAlias(request.resource.data.alias)
        && validPhoto(request.resource.data.get('photoURL', null))
        && request.resource.data.shareAlbum is bool
        && validCount(request.resource.data.sightings)
        && validCount(request.resource.data.species)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // ---- Índice de códigos de amigo: `friendCodes/{código}` → {uid}. Se lee de
    // uno en uno (quien tiene el código), nunca se lista. Lo crea el dueño en la
    // misma escritura que pone el código en su perfil, y lo borra al irse.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && validCode(code)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('friendCode', null) == code;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Las solicitudes que envió una cuenta (para retirarlas al borrarla).
    match /{path=**}/friendRequests/{fromUid} {
      allow list: if signedIn() && resource.data.from == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
