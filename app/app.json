{
  "expo": {
    "name": "Zarpa",
    "slug": "zarpa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zarpa",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F6F2",
    "ios": {
      "bundleIdentifier": "com.hrval.zarpa",
      "deploymentTarget": "17.0",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Zarpa usa la cámara para reconocer en directo al animal que tienes delante y convertir tu foto en su pegatina. Las fotos se quedan en tu móvil.",
        "NSLocationWhenInUseUsageDescription": "Zarpa usa tu ubicación para saber qué especies viven donde estás (mejora el reconocimiento) y para apuntar dónde viste cada animal.",
        "NSMotionUsageDescription": "Zarpa usa la inclinación del móvil para el brillo de los cromos raros.",
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.hrval.zarpa",
      "versionCode": 1,
      "permissions": ["android.permission.CAMERA", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FF7A1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zarpa usa tu ubicación para saber qué especies viven donde estás (mejora el reconocimiento) y para apuntar dónde viste cada animal."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
