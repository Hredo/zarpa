{
  "expo": {
    "name": "Zarpa",
    "slug": "zarpa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zarpa",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F6F2",
    "ios": {
      "bundleIdentifier": "com.hrval.zarpa",
      "deploymentTarget": "17.0",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Zarpa usa la cámara para reconocer en directo al animal que tienes delante y convertir tu foto en su pegatina. Las fotos se quedan en tu móvil.",
        "NSLocationWhenInUseUsageDescription": "Zarpa usa tu ubicación para saber qué especies viven donde estás (mejora el reconocimiento) y para apuntar dónde viste cada animal.",
        "NSMicrophoneUsageDescription": "Zarpa usa el micrófono solo cuando pulsas «Grabar» para guardar una nota de voz en un avistamiento. Las grabaciones se quedan en tu móvil.",
        "NSMotionUsageDescription": "Zarpa usa la inclinación del móvil para el brillo de los cromos raros."
      }
    },
    "android": {
      "package": "com.hrval.zarpa",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FF7A1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-sharing",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REEMPLAZAR-POR-EL-ID-DE-CLIENTE-IOS"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Zarpa usa el micrófono solo cuando pulsas «Grabar» para guardar una nota de voz en un avistamiento. Las grabaciones se quedan en tu móvil.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zarpa usa tu ubicación para saber qué especies viven donde estás (mejora el reconocimiento) y para apuntar dónde viste cada animal."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF7A1A",
          "defaultChannel": "rarezas"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
