# Configuración web de Firebase (proyecto zarpa-47a67). Son identificadores
# públicos del cliente, no secretos, pero el .env real no se sube al repo.
# Cópialo a .env y rellénalo desde Consola de Firebase → Configuración del
# proyecto → Tus apps → app web → Configuración del SDK.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=zarpa-47a67.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=zarpa-47a67
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=zarpa-47a67.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# ID de cliente OAuth «web» que crea Firebase al activar Google (Authentication → Google).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 1 = la app habla con los emuladores locales de Firebase (desarrollo).
EXPO_PUBLIC_FIREBASE_EMULATORS=0
# ID de cliente OAuth de iOS (Authentication → Google → app iOS). Solo iOS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
